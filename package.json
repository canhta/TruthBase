{
  "name": "truthbase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @truthbase/core build && vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev:web": "pnpm --filter @truthbase/web dev",
    "start:api": "pnpm --filter @truthbase/api start",
    "start:worker": "pnpm --filter @truthbase/worker start",
    "check:docs": "node scripts/check_docs.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vite": "8.3.3",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.17"
  }
}
